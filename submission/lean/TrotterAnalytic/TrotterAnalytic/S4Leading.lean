/-
  Certificate for the leading Trotter error term of the fourth-order Suzuki formula.
  Auto-generated by scripts/gen_lean.py.  Lean 4 core only (no Mathlib).

  Everything is computed inside Lean by kernel evaluation (`decide`):
  * exact rationals (normalised by gcd) and the field Q(c), c^3 = 2;
  * noncommutative polynomials in letters 0 = A, 1 = B, truncated at degree N;
  * S4 = prod of the 11 stage exponentials, its truncated logarithm;
  * comparison with A + B + sum_i c_i C_i.
-/

set_option maxRecDepth 1000000
set_option maxHeartbeats 0

namespace S4Cert

structure Q where
  num : Int
  den : Nat
deriving Repr, DecidableEq

def mkQ (n : Int) (d : Nat) : Q :=
  let g := Nat.gcd n.natAbs d
  if g = 0 then ⟨0, 1⟩ else ⟨n / (g : Int), d / g⟩

instance : Add Q := ⟨fun a b => mkQ (a.num * b.den + b.num * a.den) (a.den * b.den)⟩
instance : Mul Q := ⟨fun a b => mkQ (a.num * b.num) (a.den * b.den)⟩
instance : Neg Q := ⟨fun a => ⟨-a.num, a.den⟩⟩
instance : OfNat Q n := ⟨⟨n, 1⟩⟩

/-- a0 + a1 c + a2 c^2 with c^3 = 2 -/
structure QC where
  a0 : Q
  a1 : Q
  a2 : Q
deriving Repr, DecidableEq

instance : Add QC := ⟨fun x y => ⟨x.a0 + y.a0, x.a1 + y.a1, x.a2 + y.a2⟩⟩
instance : Neg QC := ⟨fun x => ⟨-x.a0, -x.a1, -x.a2⟩⟩
instance : Mul QC := ⟨fun x y =>
  ⟨x.a0 * y.a0 + 2 * (x.a1 * y.a2 + x.a2 * y.a1),
   x.a0 * y.a1 + x.a1 * y.a0 + 2 * (x.a2 * y.a2),
   x.a0 * y.a2 + x.a1 * y.a1 + x.a2 * y.a0⟩⟩
def QC.ofQ (q : Q) : QC := ⟨q, 0, 0⟩
def zero : QC := QC.ofQ 0
def one : QC := QC.ofQ 1
def cc : QC := ⟨0, 1, 0⟩

abbrev Word := List Nat
abbrev Poly := List (Word × QC)

def addTerm (w : Word) (x : QC) : Poly → Poly
  | [] => [(w, x)]
  | (w', y) :: t => if w = w' then (w, x + y) :: t else (w', y) :: addTerm w x t

def addPoly (p q : Poly) : Poly := q.foldl (fun acc (w, x) => addTerm w x acc) p
def scale (s : QC) (p : Poly) : Poly := p.map (fun (w, x) => (w, s * x))

def mulTrunc (N : Nat) (p q : Poly) : Poly :=
  p.foldl (fun acc (w1, x1) =>
    q.foldl (fun acc2 (w2, x2) =>
      if w1.length + w2.length ≤ N then addTerm (w1 ++ w2) (x1 * x2) acc2 else acc2) acc) []

def qpow (x : QC) : Nat → QC
  | 0 => one
  | k + 1 => x * qpow x k

def fact : Nat → Nat
  | 0 => 1
  | k + 1 => (k + 1) * fact k

def repl (l : Nat) : Nat → Word
  | 0 => []
  | k + 1 => l :: repl l k

/-- exp(g X_l) truncated at degree N -/
def expLetter (N l : Nat) (g : QC) : Poly :=
  (List.range (N + 1)).map (fun k => (repl l k, QC.ofQ (mkQ 1 (fact k)) * qpow g k))

def prodTrunc (N : Nat) (fs : List Poly) : Poly := fs.foldl (mulTrunc N) [([], one)]

/-- log(1 + Y), Y without constant term, truncated at degree N -/
def logTrunc (N : Nat) (p : Poly) : Poly :=
  let y := p.filter (fun (w, _) => w.length ≥ 1)
  let rec go : Nat → Poly → Poly → Poly
    | 0, _, acc => acc
    | fuel + 1, ypow, acc =>
      let k := N - fuel        -- k = 1, 2, ..., N
      let ypow' := mulTrunc N ypow y
      let sgn : Int := if k % 2 = 1 then 1 else -1
      go fuel ypow' (addPoly acc (scale (QC.ofQ (mkQ sgn k)) ypow'))
  go N [([], one)] []

def coeff (p : Poly) (w : Word) : QC :=
  p.foldl (fun acc (w', x) => if w = w' then acc + x else acc) zero

def homog (n : Nat) (p : Poly) : Poly := p.filter (fun (w, _) => w.length = n)

/-- p = q as polynomials (zero coefficients ignored) -/
def polyEq (p q : Poly) : Bool :=
  p.all (fun (w, _) => coeff p w = coeff q w) && q.all (fun (w, _) => coeff p w = coeff q w)

inductive Tree where
  | leaf : Nat → Tree
  | br : Tree → Tree → Tree

def Tree.poly : Tree → Poly
  | .leaf l => [([l], one)]
  | .br s t =>
    let a := s.poly
    let b := t.poly
    addPoly (mulTrunc 100 a b) (scale (-one) (mulTrunc 100 b a))

def N : Nat := 5

/-- p = 1/(4 - 4^(1/3)), given as an element of Q(c) -/
def p : QC := ⟨(mkQ (4) 15), (mkQ (1) 30), (mkQ (1) 15)⟩

theorem p_spec : p * (QC.ofQ 4 + -(cc * cc)) = one := by decide

def half : QC := QC.ofQ (mkQ 1 2)
def q : QC := one + -(QC.ofQ 4 * p)
/-- S2(h) = e^{hA/2} e^{hB} e^{hA/2}; S4 = S2(p)^2 S2(q) S2(p)^2 (11 factors after merging) -/
def stages : List (Nat × QC) :=
  [(0, half * p), (1, p), (0, p), (1, p), (0, half * (p + q)), (1, q),
   (0, half * (p + q)), (1, p), (0, p), (1, p), (0, half * p)]

def logS4 : Poly := logTrunc N (prodTrunc N (stages.map (fun (l, g) => expLetter N l g)))

/-- claimed Hall-basis coefficients of the t^5 term -/
def hall5 : List (QC × Tree) := [
  (⟨(mkQ (-169) 1350000), (mkQ (-1) 28125), (mkQ (-2437) 43200000)⟩,
   (.br (.leaf 0) (.br (.leaf 0) (.br (.leaf 0) (.br (.leaf 0) (.leaf 1)))))),
  (⟨(mkQ (-169) 337500), (mkQ (-4) 28125), (mkQ (-2437) 10800000)⟩,
   (.br (.leaf 1) (.br (.leaf 0) (.br (.leaf 0) (.br (.leaf 0) (.leaf 1)))))),
  (⟨(mkQ (-551) 900000), (mkQ (-451) 2700000), (mkQ (-371) 1350000)⟩,
   (.br (.leaf 1) (.br (.leaf 1) (.br (.leaf 0) (.br (.leaf 0) (.leaf 1)))))),
  (⟨(mkQ (-301) 1350000), (mkQ (-67) 1350000), (mkQ (-59) 600000)⟩,
   (.br (.leaf 1) (.br (.leaf 1) (.br (.leaf 1) (.br (.leaf 0) (.leaf 1)))))),
  (⟨(mkQ (-301) 900000), (mkQ (-67) 900000), (mkQ (-59) 400000)⟩,
   (.br (.br (.leaf 0) (.leaf 1)) (.br (.leaf 0) (.br (.leaf 0) (.leaf 1))))),
  (⟨(mkQ (-17) 150000), (mkQ (49) 1350000), (mkQ (-109) 2700000)⟩,
   (.br (.br (.leaf 0) (.leaf 1)) (.br (.leaf 1) (.br (.leaf 0) (.leaf 1)))))
]

def E5 : Poly := hall5.foldl (fun acc (x, t) => addPoly acc (scale x t.poly)) []

theorem degree1 : polyEq (homog 1 logS4) [([0], one), ([1], one)] = true := by decide
theorem degree2 : polyEq (homog 2 logS4) [] = true := by decide
theorem degree3 : polyEq (homog 3 logS4) [] = true := by decide
theorem degree4 : polyEq (homog 4 logS4) [] = true := by decide
theorem degree5 : polyEq (homog 5 logS4) E5 = true := by decide


def commH (t : Tree) : Poly := addPoly (Tree.br (.leaf 0) t).poly (Tree.br (.leaf 1) t).poly

/-- Theorem D: E5 = [A+B, Y] + Z, Z on B-prefixed right-nested commutators. -/
def procY : List (QC × Tree) := [
  (⟨(mkQ (-169) 1350000), (mkQ (-1) 28125), (mkQ (-2437) 43200000)⟩,
   (.br (.leaf 0) (.br (.leaf 0) (.br (.leaf 0) (.leaf 1))))),
  (⟨(mkQ (301) 900000), (mkQ (67) 900000), (mkQ (59) 400000)⟩,
   (.br (.leaf 0) (.br (.br (.leaf 0) (.leaf 1)) (.leaf 1)))),
  (⟨(mkQ (-17) 150000), (mkQ (49) 1350000), (mkQ (-109) 2700000)⟩,
   (.br (.br (.br (.leaf 0) (.leaf 1)) (.leaf 1)) (.leaf 1)))]

def procZ : List (QC × Tree) := [
  (⟨(mkQ (-37) 900000), (mkQ (-29) 900000), (mkQ (-313) 14400000)⟩,
   (.br (.leaf 1) (.br (.leaf 0) (.br (.leaf 0) (.br (.leaf 0) (.leaf 1)))))),
  (⟨(mkQ (-37) 225000), (mkQ (-29) 225000), (mkQ (-313) 3600000)⟩,
   (.br (.leaf 1) (.br (.leaf 0) (.br (.leaf 1) (.br (.leaf 0) (.leaf 1)))))),
  (⟨(mkQ (-37) 337500), (mkQ (-29) 337500), (mkQ (-313) 5400000)⟩,
   (.br (.leaf 1) (.br (.leaf 1) (.br (.leaf 1) (.br (.leaf 0) (.leaf 1))))))]

def HY_plus_Z : Poly :=
  addPoly (procY.foldl (fun acc (x, t) => addPoly acc (scale x (commH t))) [])
          (procZ.foldl (fun acc (x, t) => addPoly acc (scale x t.poly)) [])

theorem processing_identity : polyEq E5 HY_plus_Z = true := by decide

